rules_version = '2';

// Zugriffsregeln der Datenbank. Hochladen: npx firebase-tools deploy --only firestore
service cloud.firestore {
  match /databases/{database}/documents {

    // Great Guinness Game: jeder darf lesen und eintragen (so gewollt, der Link reicht).
    // Eine Tabelle ist ein Dokument. Löschen geht nur als Markierung (geloescht: true),
    // damit niemand mit einem Klick alles endgültig wegwischen kann.
    // „guinness“ = Live-Seite, „guinness-test“ = Test-Seite und lokaler Server
    match /{sammlung}/{tabelle} {
      allow read: if sammlung in ['guinness', 'guinness-test'];
      allow create, update: if sammlung in ['guinness', 'guinness-test']
        && request.resource.data.keys().hasOnly(['name', 'erstellt', 'zeit', 'geloescht', 'spieler', 'runden'])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 60;
      allow delete: if false;
    }

    // Alles andere ist gesperrt, bis es eigene Regeln bekommt (z. B. die Personendaten).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
