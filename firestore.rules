rules_version = '2';

// Zugriffsregeln der Datenbank. Hochladen: npx firebase-tools deploy --only firestore
service cloud.firestore {
  match /databases/{database}/documents {

    // Great Guinness Game: jeder darf lesen und eintragen (so gewollt, der Link reicht).
    // Ein Spiel ist ein Dokument. Gelöscht wird nichts: weder das Spiel noch Spieler oder Runden.
    // Punkte und Spielernamen dürfen überschrieben werden.
    // „guinness“ = Live-Seite, „guinness-test“ = Test-Seite und lokaler Server
    match /{sammlung}/{spiel} {
      allow read: if sammlung in ['guinness', 'guinness-test'];
      allow create: if sammlung in ['guinness', 'guinness-test'] && gueltig();
      allow update: if sammlung in ['guinness', 'guinness-test'] && gueltig()
        // kein Spieler und keine Runde darf verschwinden oder als gelöscht markiert werden
        && request.resource.data.spieler.keys().hasAll(resource.data.spieler.keys())
        && request.resource.data.runden.keys().hasAll(resource.data.runden.keys())
        && request.resource.data.get('geloescht', false) == resource.data.get('geloescht', false);
      allow delete: if false;
    }

    // Bilder: Links zu Fotos (meist Dropbox). Jeder darf lesen und hinzufügen, nichts ändern oder löschen.
    // „bilderlinks“ = Live-Seite, „bilderlinks-test“ = Test-Seite und lokaler Server
    match /{sammlung}/{link} {
      allow read: if sammlung in ['bilderlinks', 'bilderlinks-test'];
      allow create: if sammlung in ['bilderlinks', 'bilderlinks-test']
        && request.resource.data.keys().hasOnly(['name', 'url', 'erstellt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 60
        && request.resource.data.url is string
        && request.resource.data.url.size() <= 1000
        && request.resource.data.url.matches('https://[^ ]+')
        && request.resource.data.erstellt == request.time;
      allow update, delete: if false;
    }

    // Datensätze (Personendaten für Reisen): jeder sieht und ändert nur, was er selbst angelegt hat.
    // Nur Nick (per E-Mail-Link angemeldet, Adresse bestätigt) sieht und bearbeitet alle.
    // „personen“ = Live-Seite, „personen-test“ = Test-Seite und lokaler Server
    match /{sammlung}/{person} {
      allow read: if sammlung in ['personen', 'personen-test'] && request.auth != null
        && (resource.data.owner == request.auth.uid || istAdmin());
      allow create: if sammlung in ['personen', 'personen-test'] && request.auth != null
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.erstellt == request.time
        && gueltigePerson();
      allow update: if sammlung in ['personen', 'personen-test'] && request.auth != null
        && (resource.data.owner == request.auth.uid || istAdmin())
        && request.resource.data.owner == resource.data.owner
        && request.resource.data.erstellt == resource.data.erstellt
        && gueltigePerson();
      allow delete: if sammlung in ['personen', 'personen-test'] && request.auth != null
        && (resource.data.owner == request.auth.uid || istAdmin());
    }

    function istAdmin() {
      return request.auth != null
        && request.auth.token.email == 'nick.domscheit@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function gueltigePerson() {
      let d = request.resource.data;
      return d.keys().hasOnly(['owner', 'erstellt', 'geaendert', 'einwilligung',
          'vorname', 'nachname', 'geburtstag', 'geburtsort', 'nationalitaet', 'telefon', 'email',
          'ausweisart', 'ausweisnummer', 'ausgestellt', 'gueltigBis', 'behoerde', 'notiz'])
        && d.einwilligung == true
        && d.vorname is string && d.vorname.size() > 0 && d.vorname.size() <= 60
        && d.nachname is string && d.nachname.size() > 0 && d.nachname.size() <= 60
        && d.geburtstag is string && d.geburtstag.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && d.get('notiz', '').size() <= 300
        && d.get('geburtsort', '').size() <= 80 && d.get('behoerde', '').size() <= 80
        && d.get('email', '').size() <= 100 && d.get('telefon', '').size() <= 30
        && d.get('ausweisnummer', '').size() <= 20 && d.get('nationalitaet', '').size() <= 60;
    }

    function gueltig() {
      return request.resource.data.keys().hasOnly(['name', 'erstellt', 'zeit', 'geloescht', 'spieler', 'runden'])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 60
        && request.resource.data.spieler is map
        && request.resource.data.runden is map;
    }

    // Alles andere ist gesperrt, bis es eigene Regeln bekommt (z. B. die Personendaten).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
